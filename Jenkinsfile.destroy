pipeline {
    agent any

    parameters {
        string(name: 'TARGET_NAMESPACE', defaultValue: '', description: 'Namespace to delete (e.g., test-<user>-<services>)')
    }

    stages {
        stage('Validate Input') {
            steps {
                script {
                    if (!params.TARGET_NAMESPACE?.trim()) {
                        error('TARGET_NAMESPACE is required')
                    }

                    if (!(params.TARGET_NAMESPACE ==~ /^test-[a-z0-9]([-a-z0-9]*[a-z0-9])?$/)) {
                        error("Unsafe namespace '${params.TARGET_NAMESPACE}'. Only namespaces matching 'test-*' are allowed.")
                    }
                }
            }
        }

        stage('Delete Namespace') {
            steps {
                sh """
                    # Step 1: Delete operator-managed CRD resources first to release finalizers
                    kubectl delete kafka,kafkaconnect,kafkaconnector,keycloak,keycloakrealmimport,opentelemetrycollector,grafana,grafanadashboard,grafanadatasource \
                        --all -n ${params.TARGET_NAMESPACE} --ignore-not-found --timeout=60s || true

                    # Step 2: Delete PVCs (these also block namespace termination)
                    kubectl delete pvc --all -n ${params.TARGET_NAMESPACE} --ignore-not-found --timeout=60s || true

                    # Step 3: Delete the namespace
                    kubectl delete namespace ${params.TARGET_NAMESPACE} --ignore-not-found

                    # Step 4: Wait for namespace to be fully removed (up to 3 minutes)
                    echo "Waiting for namespace ${params.TARGET_NAMESPACE} to be fully deleted..."
                    for i in \$(seq 1 18); do
                        if ! kubectl get namespace ${params.TARGET_NAMESPACE} > /dev/null 2>&1; then
                            echo "Namespace ${params.TARGET_NAMESPACE} deleted successfully."
                            exit 0
                        fi
                        echo "Still waiting... (\${i}/18)"
                        sleep 10
                    done

                    # Step 5: If still stuck, patch all remaining resources to remove finalizers
                    echo "Namespace still in Terminating state. Removing finalizers from stuck resources..."
                    for resource in \$(kubectl api-resources --verbs=list --namespaced -o name 2>/dev/null); do
                        kubectl get "\$resource" -n ${params.TARGET_NAMESPACE} -o name 2>/dev/null | while read item; do
                            kubectl patch "\$item" -n ${params.TARGET_NAMESPACE} -p '{"metadata":{"finalizers":[]}}' --type=merge 2>/dev/null || true
                        done
                    done

                    # Final check
                    if kubectl get namespace ${params.TARGET_NAMESPACE} > /dev/null 2>&1; then
                        echo "ERROR: Namespace ${params.TARGET_NAMESPACE} is still present after cleanup."
                        exit 1
                    fi
                    echo "Namespace ${params.TARGET_NAMESPACE} deleted successfully."
                """
            }
        }
    }

    post {
        success {
            script {
                echo "========================================================================"
                echo "CLEANUP SUCCESSFUL!"
                echo "Namespace ${params.TARGET_NAMESPACE} deleted successfully."
                echo "========================================================================"

                currentBuild.displayName = "#${currentBuild.number} - ${params.TARGET_NAMESPACE}"
                currentBuild.description = "Namespace ${params.TARGET_NAMESPACE} deleted successfully."
            }
        }
        failure {
            script {
                echo "========================================================================"
                echo "CLEANUP FAILED!"
                echo "Failed to delete namespace ${params.TARGET_NAMESPACE}."
                echo "========================================================================"

                currentBuild.displayName = "#${currentBuild.number} - ${params.TARGET_NAMESPACE}"
                currentBuild.description = "Failed to delete namespace ${params.TARGET_NAMESPACE}."
            }
        }
    }
}
